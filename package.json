{
  "name": "pi-settings-studio",
  "version": "0.1.1",
  "description": "A local settings-only GUI for Pi core configuration",
  "type": "module",
  "license": "MIT",
  "author": "Gohans",
  "homepage": "https://github.com/Gohans1/pi-settings-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gohans1/pi-settings-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Gohans1/pi-settings-studio/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "settings",
    "gui",
    "mcp",
    "skills",
    "bun"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "pi-settings-studio": "src/server/cli.ts"
  },
  "files": [
    "src/server",
    "src/shared",
    "dist/client",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests e2e scripts",
    "build": "vite build && vite build --mode demo",
    "build:demo": "vite build --mode demo",
    "test:e2e": "bun --bun playwright test",
    "start": "bun src/server/cli.ts",
    "record:demo": "bun src/demo/record.ts",
    "deploy:demo": "bun run build:demo && bun x wrangler deploy",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@hono/bun": "1.0.0",
    "hono": "4.13.13",
    "minimatch": "10.2.6",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@base-ui/react": "1.8.0",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "cuelume": "0.2.4",
    "lucide-react": "1.52.0",
    "oxlint": "1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "trustedDependencies": []
}
